# Copy to .env. Read by `expo start` and by docker compose.

# Backend base URL. Must be reachable from where the app runs (the phone or the
# browser), not from inside the container — on a physical device use your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Docker only ---------------------------------------------------------------
# Your machine's LAN IP, so a phone running Expo Go can reach Metro in the
# container, e.g. 192.168.1.20
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
# Host ports
METRO_PORT=8081
WEB_PORT=8088
